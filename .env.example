# 이 파일을 .env로 복사해서 값을 채운다. .env는 git에 올리지 않는다.

# ── LLM ─────────────────────────────────────────
# anthropic | openai | none (none이면 키워드 규칙 기반으로만 분류·채점, 번역·요약 없음)
LLM_PROVIDER=none
# 비워 두면 기본값: anthropic → claude-haiku-5-5(기사 분석) / claude-sonnet-5-5(브리핑 종합)
LLM_MODEL=
LLM_BRIEFING_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# 1회 실행에서 LLM으로 분석할 최대 기사 수 (비용 상한)
LLM_MAX_ARTICLES_PER_RUN=120

# ── ntfy ────────────────────────────────────────
NTFY_BASE_URL=https://ntfy.sh
# ntfy.sh 공개 서버의 토픽은 이름을 아는 누구나 구독할 수 있다 → 추측하기 어려운 이름을 쓴다
NTFY_DAILY_TOPIC=
NTFY_WIRED_TOPIC=
NTFY_ALERT_TOPIC=
# 접근 제어가 걸린 토픽/자체 서버라면 액세스 토큰 (tk_...)
NTFY_TOKEN=
# true면 실제로 보내지 않고 로그·DB에만 기록 (기본값 true — 확인 후 false로)
NTFY_DRY_RUN=true
NTFY_MAX_RETRIES=3

# 브리핑 HTML 공개 주소 (예: https://<계정>.github.io/<저장소>). 비우면 푸시 클릭 링크 없음
BRIEFING_PUBLIC_BASE_URL=

# ── 임계값 ──────────────────────────────────────
WIRED_ALERT_THRESHOLD=80
BREAKING_THRESHOLD=90
# true면 WIRED 외 모든 출처에도 90점 이상 속보 알림 (MVP 기본은 WIRED만)
BREAKING_ALL_SOURCES=false
COLLECT_LOOKBACK_HOURS=48

# ── 저장소 ──────────────────────────────────────
# 비우면 data/radar.db(SQLite). PostgreSQL/Supabase 예: postgresql+psycopg://user:pass@host:5432/db
DATABASE_URL=
